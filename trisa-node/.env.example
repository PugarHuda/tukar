# Copy to .env and fill in after the GDS issues your certificates. Nothing here is secret by
# default except TRISA_CERTS_PASSWORD. The node reads these on startup.

# mTLS gRPC endpoint TRISA peers dial. In production this is fronted by your public host:port
# registered in the directory (e.g. Fly maps 443 -> 4433).
LISTEN_ADDR=:4433

# Localhost HTTP bridge the Next.js app calls. Keep it on localhost; it has no auth of its own.
# Set webapp env TRISA_NODE_URL=http://127.0.0.1:8091 to match.
BRIDGE_ADDR=127.0.0.1:8091

# Path to the identity certificate archive issued by the GDS (zip / pem / pkcs12).
TRISA_CERTS=./certs/trisa.identity.zip

# Trust chain pool. Leave unset to reuse TRISA_CERTS when the archive bundles the chain.
TRISA_CHAIN=./certs/trisa.identity.zip

# PKCS12 password, if the archive is encrypted. Leave empty for an unencrypted PEM/zip bundle.
TRISA_CERTS_PASSWORD=

# Global TRISA Directory lookup endpoint. Testnet: api.trisatest.net:443
# Mainnet: api.vaspdirectory.net:443
DIRECTORY=api.trisatest.net:443

# Your own registered common name (must match the identity certificate).
TRISA_COMMON_NAME=
