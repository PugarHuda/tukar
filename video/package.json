{
  "name": "tukar-video",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion composition for the Tukar demo video. Captures come from scripts/capture.mjs (Playwright on the real app).",
  "scripts": {
    "vo": "python vo.py",
    "capture": "node capture.mjs",
    "prep": "node prep.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts TukarDemo out/tukar-demo.mp4 --concurrency=2 --crf=20",
    "all": "npm run vo && npm run capture && npm run prep && npm run render && npm run ship",
    "ship": "node ship.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.418",
    "@remotion/google-fonts": "^4.0.418",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.418"
  },
  "devDependencies": {
    "@types/react": "^19",
    "playwright-core": "^1.61.1",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.25.0": true
  }
}