{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/demo/send", "destination": "/demo.html" },
    { "source": "/demo/corridor", "destination": "/demo.html" },
    { "source": "/demo/receive", "destination": "/demo.html" },
    { "source": "/demo/audit", "destination": "/demo.html" }
  ],
  "headers": [
    {
      "source": "/circuit/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
