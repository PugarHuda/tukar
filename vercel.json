{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd webapp && npm install",
  "buildCommand": "cd webapp && npm run build",
  "outputDirectory": "webapp/out",
  "cleanUrls": true,
  "redirects": [
    { "source": "/demo/send", "destination": "/demo" },
    { "source": "/demo/corridor", "destination": "/demo" },
    { "source": "/demo/receive", "destination": "/demo" },
    { "source": "/demo/audit", "destination": "/demo" }
  ],
  "headers": [
    {
      "source": "/.well-known/stellar.toml",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/circuit/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
